      <text x="185" y="148" text-anchor="middle" dominant-baseline="middle" class="svg-title">控制 / 风格</text>
      <text x="185" y="165" text-anchor="middle" dominant-baseline="middle" class="svg-sub">ControlNet / IPAdapter</text>

