.topbar a.nav:hover{background:var(--accent-soft);color:var(--accent)}
.progress{position:fixed;top:0;left:0;height:2px;background:var(--cat);z-index:40;width:0}
main{max-width:960px;margin:0 auto;padding:34px 22px 80px}
.crumbs{font-family:var(--sans);font-size:12.5px;color:var(--muted);letter-spacing:.04em;margin:0 0 18px}
.crumbs a{color:var(--muted);text-decoration:none}.crumbs a:hover{color:var(--accent)}
.crumbs .sep{margin:0 7px;color:var(--line2)}
.kicker{display:inline-flex;align-items:center;gap:8px;font-family:var(--sans);font-size:12px;font-weight:700;letter-spacing:.12em;color:var(--cat);background:var(--cat-soft);padding:6px 11px;border-radius:999px}
.kicker::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--cat)}
h1{font-family:var(--sans);font-size:42px;line-height:1.25;margin:16px 0 12px;font-weight:800;letter-spacing:-.01em}
.lede{font-size:18px;color:var(--muted);margin:0;max-width:680px}
.hero{margin-bottom:26px}
.map4{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:22px}
