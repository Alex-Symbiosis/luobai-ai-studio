<script>
(function(){
  "use strict";
  var bar=document.getElementById('progress');
  function onScroll(){var h=document.documentElement;var max=h.scrollHeight-h.clientHeight;bar.style.width=(max>0?h.scrollTop/max*100:0)+'%';}
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();

  // CFG 滑杆
  var cfg=document.getElementById('cfgRange'),cfgVal=document.getElementById('cfgVal');
  var mFollow=document.getElementById('mFollow'),mFree=document.getElementById('mFree');
  var tFollow=document.getElementById('tFollow'),tFree=document.getElementById('tFree');
  var cfgVerdict=document.getElementById('cfgVerdict');
  function updCfg(){
    var v=parseFloat(cfg.value);
    cfgVal.textContent=v.toFixed(1);
    var follow=Math.min(99,Math.round(18+30*Math.log(v)));
    var free=Math.max(8,Math.round(100-(v-1)*7.5));
    mFollow.style.width=follow+'%';mFree.style.width=free+'%';
    tFollow.textContent=follow+'%';tFree.textContent=free+'%';
    var s;
    if(v<2){s=v.toFixed(1)+'：引导很弱，画面自由但容易不听提示词。';}
    else if(v<4){s=v.toFixed(1)+'：SDXL 常用区间，既听提示词，也保留自然的光影。';}
    else if(v<7){s=v.toFixed(1)+'：明显更服从，代价是色彩更容易发硬、发艳。';}
    else{s=v.toFixed(1)+'：高引导区，结构崩坏和过曝的风险明显上升。';}
    cfgVerdict.textContent=s;
  }
  cfg.addEventListener('input',updCfg);updCfg();

  // 种子演示
  function rnd(){return Math.floor(Math.random()*900000)+100000;}
  var a=739201,b=154876;
  var fA=document.getElementById('nzA'),fB=document.getElementById('nzB');
  function render(){
    fA.setAttribute('seed',String(a));
    fB.setAttribute('seed',String(b));
    document.getElementById('idA').textContent='seed '+a;
    document.getElementById('idB').textContent='seed '+b;
    var same=(a===b);
    document.getElementById('seedPair').textContent=same?'A = B':'A ≠ B';
    document.getElementById('labelA').textContent=same?'已锁定':'随机';
    document.getElementById('labelB').textContent=same?'已锁定':'随机';
  }
  document.getElementById('btnRandom').addEventListener('click',function(){a=rnd();b=rnd();render();});
  document.getElementById('btnLock').addEventListener('click',function(){b=a;render();});
  render();

  document.querySelectorAll('.check input').forEach(function(box,i){
    var key='l1-03-check-'+i;
    try{if(localStorage.getItem(key)==='1'){box.checked=true;box.closest('.check').classList.add('done');}}catch(e){}
    box.addEventListener('change',function(){
      box.closest('.check').classList.toggle('done',box.checked);
      try{localStorage.setItem(key,box.checked?'1':'0');}catch(e){}
    });
  });
})();
</script>
