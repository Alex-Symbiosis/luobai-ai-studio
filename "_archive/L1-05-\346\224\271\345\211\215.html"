<script>
(function(){
  "use strict";
  var bar=document.getElementById('progress');
  function onScroll(){var h=document.documentElement;var max=h.scrollHeight-h.clientHeight;bar.style.width=(max>0?h.scrollTop/max*100:0)+'%';}
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();

  var w=document.getElementById('wRange'),e=document.getElementById('eRange');
  var wTxt=document.getElementById('wTxt'),eTxt=document.getElementById('eTxt'),ipVal=document.getElementById('ipVal');
  var mStyle=document.getElementById('mStyle'),mContent=document.getElementById('mContent');
  var tStyle=document.getElementById('tStyle'),tContent=document.getElementById('tContent');
  var ipVerdict=document.getElementById('ipVerdict');
  function upd(){
    var wv=parseInt(w.value,10)/100;
    var ev=parseInt(e.value,10)/100;
    wTxt.textContent=wv.toFixed(2);eTxt.textContent=ev.toFixed(2);
    ipVal.textContent=wv.toFixed(2)+' / '+ev.toFixed(2);
    var style=Math.round(wv*100);
    var content=Math.round(100-wv*58-((1-ev)*18));
    content=Math.max(5,Math.min(100,content));
    mStyle.style.width=style+'%';mContent.style.width=content+'%';
    tStyle.textContent=style+'%';tContent.textContent=content+'%';
    var s;
    if(wv<0.35){s='风格很淡，更像“轻微调色”；适合只想要一点氛围。';}
    else if(wv<0.6){s='风格与内容较平衡，参考图的气质开始稳定出现。';}
    else if(wv<=0.85){s='本套工作流的区间（0.70–0.80）：风格明显，仍需结构约束配合。';}
    else{s='风格压过内容，容易出现材质糊、颜色重、结构被带跑。';}
    if(ev<0.5){s+=' 停止点偏早，后半段几乎完全交还给模型。';}
    else if(ev<0.9){s+=' 后半段逐步松手，细节更自然。';}
    else{s+=' 接近全程注入，风格更稳，但细节自由度更低。';}
    ipVerdict.textContent=s;
  }
  w.addEventListener('input',upd);e.addEventListener('input',upd);upd();

  document.querySelectorAll('.check input').forEach(function(box,i){
    var key='l1-05-check-'+i;
    try{if(localStorage.getItem(key)==='1'){box.checked=true;box.closest('.check').classList.add('done');}}catch(e){}
    box.addEventListener('change',function(){
      box.closest('.check').classList.toggle('done',box.checked);
      try{localStorage.setItem(key,box.checked?'1':'0');}catch(e){}
    });
  });
})();
</script>
