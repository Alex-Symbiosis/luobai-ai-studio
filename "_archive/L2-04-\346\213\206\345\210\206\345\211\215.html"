.ex b{color:var(--teal)}
.pit{font-family:var(--sans);font-size:12.5px;color:var(--amber);margin:8px 0 0;line-height:1.7}
.recipe{counter-reset:r;margin:18px 0;display:grid;gap:9px}
.recipe .step{position:relative;background:var(--card);border:1px solid var(--line);border-radius:11px;padding:11px 14px 11px 46px;font-family:var(--sans);font-size:13.5px;color:var(--muted);line-height:1.7}
.recipe .step::before{counter-increment:r;content:counter(r);position:absolute;left:13px;top:12px;width:22px;height:22px;border-radius:50%;background:var(--teal-soft);color:var(--teal);font-family:var(--mono);font-size:11px;font-weight:700;display:grid;place-items:center}
.recipe .step b{color:var(--ink)}
.practice{display:grid;gap:12px;margin:20px 0}
.task{display:grid;grid-template-columns:30px 1fr;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
.task .idx{font-family:var(--mono);font-size:12px;font-weight:700;color:var(--teal);background:var(--teal-soft);border-radius:50%;width:26px;height:26px;display:grid;place-items:center;margin-top:2px}
.task p{margin:0;font-family:var(--sans);font-size:14.5px}.task .why{color:var(--muted);font-size:13px;margin-top:4px}
.checklist{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);padding:18px 20px;margin:20px 0;box-shadow:var(--shadow)}
.checklist h4{font-family:var(--sans);font-size:14px;margin:0 0 10px;letter-spacing:.04em;color:var(--muted)}
.check{display:flex;gap:10px;align-items:flex-start;padding:7px 0;font-family:var(--sans);font-size:14px;cursor:pointer;border-bottom:1px dashed var(--line)}
.check:last-child{border-bottom:none}
.check input{margin:4px 0 0;accent-color:var(--teal);width:16px;height:16px;flex:none}
.check.done span{color:var(--faint);text-decoration:line-through}
.pager{display:flex;justify-content:space-between;gap:14px;margin-top:56px;padding-top:22px;border-top:1px solid var(--line);font-family:var(--sans);font-size:13.5px}
.pager a{text-decoration:none;color:var(--muted);background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 14px;max-width:48%}
.pager a:hover{border-color:var(--teal);color:var(--teal)}
.pager .dir{display:block;font-size:10.5px;letter-spacing:.1em;color:var(--faint);margin-bottom:2px}
footer{margin-top:46px;font-family:var(--sans);font-size:12px;color:var(--faint);text-align:center;line-height:1.8}
