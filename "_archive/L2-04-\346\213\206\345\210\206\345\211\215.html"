.entry .body th,.entry .body td{padding:6px 6px}
.io{display:flex;flex-wrap:wrap;gap:5px;margin:6px 0 10px;font-family:var(--mono);font-size:10.5px}
.io span{border-radius:5px;padding:2px 6px;background:#f2f0ea;color:var(--muted)}
.io .out{background:var(--teal-soft);color:var(--teal)}
