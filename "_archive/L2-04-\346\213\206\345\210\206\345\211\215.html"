.brand{font-weight:700;color:var(--ink);text-decoration:none}.brand span{color:var(--accent)}
.topbar .sp{flex:1}
.topbar a.nav{color:var(--muted);text-decoration:none;padding:4px 8px;border-radius:8px}
.topbar a.nav:hover{background:var(--accent-soft);color:var(--accent)}
.progress{position:fixed;top:0;left:0;height:2px;background:var(--teal);z-index:40;width:0}
