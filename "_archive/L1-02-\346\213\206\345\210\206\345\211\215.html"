<script>
(function(){
  "use strict";
  var bar=document.getElementById('progress');
  function onScroll(){var h=document.documentElement;var max=h.scrollHeight-h.clientHeight;bar.style.width=(max>0?h.scrollTop/max*100:0)+'%';}
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();

  var range=document.getElementById('stepRange');
  var stepVal=document.getElementById('stepVal');
  var mDetail=document.getElementById('mDetail'),mTime=document.getElementById('mTime'),mStable=document.getElementById('mStable');
  var tDetail=document.getElementById('tDetail'),tTime=document.getElementById('tTime'),tStable=document.getElementById('tStable');
  var verdict=document.getElementById('verdict');
  function update(){
    var s=parseInt(range.value,10);
    stepVal.textContent=s+' 步';
    // 细节：对数式增长，4 步约 45%，15 步约 86%，40 步约 97%
    var detail=Math.min(98,Math.round(30+22*Math.log(s)));
    var time=Math.round(s/40*100);
    var stable=Math.min(96,Math.round(40+26*Math.log(s)));
    mDetail.style.width=detail+'%';mTime.style.width=time+'%';mStable.style.width=stable+'%';
    tDetail.textContent=detail+'%';tTime.textContent=time+'%';tStable.textContent=stable+'%';
    var v;
    if(s<8){v=s+' 步：太快了，结构常常还没搭完，适合只看构图草案。';}
    else if(s<12){v=s+' 步：轻量档，出图快，细节和文字边缘会偏软。';}
    else if(s<=25){v=s+' 步：常规区间，结构基本完整，适合大多数 SDXL 效果图。';}
    else{v=s+' 步：已经进入收益递减区；除非模型明确推荐，否则不必再加。';}
    verdict.textContent=v;
  }
  range.addEventListener('input',update);update();

  document.querySelectorAll('.check input').forEach(function(box,i){
    var key='l1-02-check-'+i;
    try{if(localStorage.getItem(key)==='1'){box.checked=true;box.closest('.check').classList.add('done');}}catch(e){}
    box.addEventListener('change',function(){
      box.closest('.check').classList.toggle('done',box.checked);
      try{localStorage.setItem(key,box.checked?'1':'0');}catch(e){}
    });
  });
})();
</script>
