<script>
(function () {
  var search = document.getElementById('glSearch');
  var status = document.getElementById('glStatus');
  var empty = document.getElementById('glEmpty');
  if (!search || !status) return;

  var letterBtns = Array.prototype.slice.call(document.querySelectorAll('.letter'));
  var rows = Array.prototype.slice.call(document.querySelectorAll('.gl-row'));
  var subgroups = Array.prototype.slice.call(document.querySelectorAll('.gl-subgroup'));
  var groups = Array.prototype.slice.call(document.querySelectorAll('.gl-group'));
  var active = 'ALL';

  rows.forEach(function (row) {
    var keys = (row.getAttribute('data-py') || '').toUpperCase().split(/\s+/);
    row._keys = keys.filter(Boolean);
    row._text = (row.textContent || '').toLowerCase().replace(/\s+/g, ' ');
  });

  function usedLetters() {
    var used = {};
    rows.forEach(function (row) {
      row._keys.forEach(function (k) { used[k] = (used[k] || 0) + 1; });
    });
    return used;
  }

  function paintLetters() {
    var used = usedLetters();
    letterBtns.forEach(function (btn) {
      var key = btn.getAttribute('data-letter');
      if (key === 'ALL') return;
      var n = used[key] || 0;
      btn.classList.toggle('empty', n === 0);
      btn.setAttribute('aria-disabled', n === 0 ? 'true' : 'false');
      btn.title = n ? key + ' · ' + n + ' 条' : key + ' · 无收录';
    });
  }

  function selectLetter(key) {
    active = key;
    letterBtns.forEach(function (btn) {
      var on = btn.getAttribute('data-letter') === key;
      btn.classList.toggle('on', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }

  function apply() {
    var q = (search.value || '').trim().toLowerCase();
    var shown = 0;

    rows.forEach(function (row) {
      var hitLetter = active === 'ALL' || row._keys.indexOf(active) !== -1;
      var hitText = !q || row._text.indexOf(q) !== -1;
      var ok = hitLetter && hitText;
      row.hidden = !ok;
      if (ok) shown++;
    });

    subgroups.forEach(function (sub) {
      sub.hidden = !sub.querySelector('.gl-row:not([hidden])');
    });
    groups.forEach(function (group) {
      group.hidden = !group.querySelector('.gl-row:not([hidden])');
    });

    var label = active === 'ALL' ? '全部' : active;
    var suffix = q ? ' · 关键词“' + search.value.trim() + '”' : '';
    status.textContent = label + ' · ' + shown + ' 条' + suffix;
    if (empty) empty.hidden = shown !== 0;
  }

  letterBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (btn.classList.contains('empty')) return;
      selectLetter(btn.getAttribute('data-letter'));
      apply();
    });
  });

  search.addEventListener('input', function () {
    if (search.value.trim() && active !== 'ALL') selectLetter('ALL');
    apply();
  });

  search.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      search.value = '';
      selectLetter('ALL');
      apply();
    }
  });

  Array.prototype.slice.call(document.querySelectorAll('nav.toc a')).forEach(function (link) {
    link.addEventListener('click', function () {
      if (active !== 'ALL' || search.value.trim()) {
        search.value = '';
        selectLetter('ALL');
        apply();
      }
    });
  });

  paintLetters();
  apply();
})();

</script>
