<script>
(function(){
  "use strict";
  // 顶部阅读进度
  var bar=document.getElementById('progress');
  function onScroll(){
    var h=document.documentElement;
    var max=h.scrollHeight-h.clientHeight;
    bar.style.width=(max>0?(h.scrollTop/max*100):0)+'%';
  }
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();

  // 尺寸计算器
  var range=document.getElementById('sideRange');
  var sideVal=document.getElementById('sideVal');
  var pxOut=document.getElementById('pxOut');
  var latOut=document.getElementById('latOut');
  var ratioOut=document.getElementById('ratioOut');
  function fmt(n){return n.toLocaleString('zh-CN');}
  function calc(){
    var side=parseInt(range.value,10);
    var px=side*side*3;
    var lat=Math.round(side/8);
    var latNums=lat*lat*4;
    sideVal.textContent=side+' px';
    pxOut.textContent=fmt(px);
    latOut.textContent=lat+' × '+lat+' × 4';
    ratioOut.textContent=(px/latNums).toFixed(1).replace('.0','')+' ×';
  }
  range.addEventListener('input',calc);calc();

  // 自检清单持久化
  var boxes=document.querySelectorAll('.check input');
  boxes.forEach(function(box,i){
    var key='l1-01-check-'+i;
    try{ if(localStorage.getItem(key)==='1'){box.checked=true;box.closest('.check').classList.add('done');} }catch(e){}
    box.addEventListener('change',function(){
      box.closest('.check').classList.toggle('done',box.checked);
      try{localStorage.setItem(key,box.checked?'1':'0');}catch(e){}
    });
  });
})();
</script>
