          <!-- bottom: workflow -->
          <text class="s-ts" x="24" y="144" font-weight="700" fill="#0f7a6c">工作流式：一条可检查的链</text>

          <rect class="s-box" x="24" y="174" width="118" height="58" rx="8"/>
          <text class="s-tb" x="40" y="197">加载模型</text>
          <text class="s-ts" x="40" y="215">Checkpoint</text>

          <rect class="s-box-s" x="182" y="174" width="118" height="58" rx="8"/>
