<script>
(function(){
  "use strict";
  var bar=document.getElementById('progress');
  function onScroll(){var h=document.documentElement;var max=h.scrollHeight-h.clientHeight;bar.style.width=(max>0?h.scrollTop/max*100:0)+'%';}
  window.addEventListener('scroll',onScroll,{passive:true});onScroll();

  var r=document.getElementById('stRange');
  var stVal=document.getElementById('stVal');
  var mLock=document.getElementById('mLock'),mFree=document.getElementById('mFree');
  var tLock=document.getElementById('tLock'),tFree=document.getElementById('tFree');
  var stVerdict=document.getElementById('stVerdict');
  function upd(){
    var v=parseInt(r.value,10)/100;
    stVal.textContent=v.toFixed(2);
    var lock=Math.round(v*100);
    var free=100-lock;
    mLock.style.width=lock+'%';mFree.style.width=free+'%';
    tLock.textContent=lock+'%';tFree.textContent=free+'%';
    var s;
    if(v<0.15){s=v.toFixed(2)+'：几乎不约束，控制图只是轻微提示。';}
    else if(v<0.4){s=v.toFixed(2)+'：保留较多参考图结构，同时给材质与光影留空间（03/04 的做法）。';}
    else if(v<0.65){s=v.toFixed(2)+'：平衡区，轮廓更严格（01/02/IPA 的做法）。';}
    else if(v<0.9){s=v.toFixed(2)+'：强约束，适合必须贴形的任务。';}
    else{s=v.toFixed(2)+'：几乎锁死结构；叠加控制时慎用，容易发僵。';}
    stVerdict.textContent=s;
  }
  r.addEventListener('input',upd);upd();

  document.querySelectorAll('.check input').forEach(function(box,i){
    var key='l1-04-check-'+i;
    try{if(localStorage.getItem(key)==='1'){box.checked=true;box.closest('.check').classList.add('done');}}catch(e){}
    box.addEventListener('change',function(){
      box.closest('.check').classList.toggle('done',box.checked);
      try{localStorage.setItem(key,box.checked?'1':'0');}catch(e){}
    });
  });
})();
</script>
